// Windows resource script for pacific-squadron (generated by CMake from
// packaging/pacific-squadron.rc.in -- do not edit the copy in the build tree).
//
// Embeds the multi-resolution icon so Explorer, the taskbar and Alt+Tab show
// the game's artwork instead of the default application icon. The .ico carries
// 16/24/32/48/64/128/256 px and Windows picks whichever size it needs.
//
// Regenerate the icon pack with:  python tools/make_icons.py
//
// No <winres.h>: we only need a numeric resource ID, and that header is not
// present in every Windows SDK / windres distribution.

#define IDI_PACIFIC_SQUADRON 101

IDI_PACIFIC_SQUADRON ICON "@PACIFIC_SQUADRON_ICO@"
