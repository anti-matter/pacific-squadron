#pragma once
// Generated at configure time from the project() VERSION in CMakeLists.txt.
// Do not edit this file: bump the release by changing
//     project(wwii_fighter VERSION major.minor.bugfix ...)
// in CMakeLists.txt. That single line also feeds the macOS bundle plist
// (CFBundleVersion / CFBundleShortVersionString), so the splash screen, the
// Finder "Get Info" panel and the debug build stamp can never disagree.

#define WW_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define WW_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define WW_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define WW_VERSION_STRING "@PROJECT_VERSION@"
